# QUERYFLOW CONFIGURATION EXAMPLE
# Copy to .env, add your own API key, then start the server with --env-file .env.
# Keep .env private; only this example file belongs in Git.

# DATABASE ---------------------------------------------------------------
# The bundled books database makes this example runnable after cloning.
# Change the ID when you add another database under the data directory.
TEXT2SQL_DATABASE_ROOT=data
TEXT2SQL_DEFAULT_DB_ID=books
# Optional generated column/table profiles are read from this directory.
TEXT2SQL_PROFILE_ROOT=profiles

# MODEL ------------------------------------------------------------------
# One provider and one model are used for SQL, conversation, and plotting.
# Replace the empty key with a key from your own account.
GROQ_API_KEY=
TEXT2SQL_SQL_PROVIDER=groq
TEXT2SQL_SQL_MODEL=qwen/qwen3.8-27b

# QUERY PIPELINE ---------------------------------------------------------
# Retrieval selects schema context without calling a second context model.
TEXT2SQL_CONTEXT_MODE=retrieval
# The assistant handles conversational follow-ups and chart requests.
TEXT2SQL_CONVERSATIONAL_AGENT_ENABLED=true

# REQUEST LIMITS ---------------------------------------------------------
# These limits bound total time, model calls, and database calls per request.
TEXT2SQL_REQUEST_TIMEOUT_SECONDS=180
TEXT2SQL_REQUEST_MAX_MODEL_CALLS=6
TEXT2SQL_REQUEST_MAX_DATABASE_CALLS=24

# HISTORY AND SAFETY -----------------------------------------------------
# History is stored locally; generated SQL remains subject to read-only checks.
TEXT2SQL_RUN_HISTORY_PATH=data/runtime/query_history.sqlite
# Leave administrative SQL execution disabled for normal use.
TEXT2SQL_ENABLE_ADMIN_CHECK_EXECUTION=false
